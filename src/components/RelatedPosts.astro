---
// RelatedPosts.astro —— 卷尾同观
//
// 落款之后、卷前卷后之前的一小节：按同分类推荐几篇「同观」，
// 没有同类文章就退回最近更新的几篇。数据在文章页构建期算好传进来，
// 组件只管排版——一列纸签行，行首空心墨点、悬停变朱砂，与归档页同一套语言。
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from '@utils/urlUtils';
import { formatMonthDay } from '@/utils/time';

interface Post {
    id: string;
    title: string;
    pubDate: Date;
}
interface Props {
    posts: Post[];
    lang: string;
}
const { posts, lang } = Astro.props;
---

{posts.length > 0 && (
    <nav class="tg" aria-label="卷尾同观">
        <h2 class="tg-heading">
            <span class="tg-dot" aria-hidden="true"></span>
            同观
        </h2>
        <ul class="tg-list">
            {posts.map((post) => (
                <li>
                    <a
                        class="group tg-row"
                        href={getRelativeLocaleUrl(lang, `/blog/${post.id}`)}
                    >
                        <span class="tg-row-dot" aria-hidden="true"></span>
                        <span class="tg-title">{post.title}</span>
                        <span class="tg-date">
                            <Icon name="fa6-solid:calendar-days" class="mr-1" />
                            {formatMonthDay(post.pubDate, lang)}
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}

<style>
    .tg {
        margin-top: 2rem;
        padding: 0 0.5rem;
    }

    /* 节名：与归档年份头同一枚朱砂菱印 */
    .tg-heading {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-family: var(--serif-head);
        font-weight: 400;
        font-size: 1.12rem;
        letter-spacing: 0.14em;
        color: var(--ink-strong);
        margin-bottom: 0.6rem;
    }

    .tg-dot {
        width: 8px;
        height: 8px;
        background: var(--accent);
        border-radius: 1.5px;
        transform: rotate(45deg);
        flex: none;
    }

    .tg-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .tg-row {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
        padding: 0.48rem 0.65rem;
        border-radius: 2px;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .tg-row:hover {
        background: var(--paper-deep);
    }

    /* 行首空心墨点：悬停变实心朱砂（归档行同款） */
    .tg-row-dot {
        width: 5px;
        height: 5px;
        border: 1px solid var(--ink-mute);
        border-radius: 50%;
        flex: none;
        align-self: center;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .tg-row:hover .tg-row-dot {
        background: var(--accent);
        border-color: var(--accent);
    }

    .tg-title {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--serif);
        font-size: 0.98rem;
        color: var(--ink-strong);
        transition: color 0.2s ease;
    }

    .tg-row:hover .tg-title {
        color: var(--accent);
    }

    .tg-date {
        color: var(--ink-mute);
        font-size: 0.82rem;
        white-space: nowrap;
    }

    @media (max-width: 640px) {
        .tg-date {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tg-row,
        .tg-row-dot,
        .tg-title {
            transition: none;
        }
    }
</style>
