---
import "@styles/global.css"
import ImageModule from "./misc/ImageModule.astro";

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content'

import { getRelativeLocaleUrl } from '@utils/urlUtils';
import { formatFullDate } from '@/utils/time'
import { cnNumber, cnReadingTime } from '@utils/cnText'
import { railTitleFor } from '@utils/railTitle.js'

import { siteConfig } from '@/config';
import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import { Icon } from "astro-icon/components";

interface Props {
    entry: CollectionEntry<'blog'>;
    title: string;
    description: string;
    image: string;
    pubDate: Date;
    url: string;
    fallback: boolean;
    priority?: boolean;
}

const { entry, title, description, image, pubDate, url, fallback, priority = false } = Astro.props;

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const pageUrl = getRelativeLocaleUrl(currentLang, "/blog/" + url);

const { remarkPluginFrontmatter } = await render(entry);

// 首页文章卡片封面图模式："background" 将图片作为卡片背景，从右向左渐隐
const isBgMode = siteConfig.theme.postCard.imageMode === "background";

// 题签只刻「中文主词」，规则见 @utils/railTitle（新建文章的脚手架用同一个函数把结果
// 填进 frontmatter 的 railTitle）
const railText = railTitleFor(entry.data.title, entry.data.railTitle);
// 题签已经是完整标题时就不再横排重复一遍（如「你好，宣」）
const showTitleInContent = railText !== entry.data.title;
---

<div class="post-card-wrap" data-aos="fade-up">
<div class:list={["post-card xuan-paper relative block min-w-0 w-full overflow-hidden", isBgMode && "postcard-bg-mode", isBgMode && image && "has-image"]}>
    {/* 左侧一条竖排题签：有没有封面都插同一枚书签，卡片看起来是一套东西。
        悬停时签脚盖一枚小「宣」印，见 .tientie-seal */}
    <a href={pageUrl} class="tientie" aria-label={title}>
        {entry.data.pinTop > 0 && <Icon name="fluent:pin-24-filled" class="tientie-pin" />}
        <span class="tientie-text">{railText}</span>
        <span class="tientie-seal" aria-hidden="true">宣</span>
    </a>
    {/* 右侧：有封面就上图上文，没封面就只是一段文字 */}
    <div class="tientie-content">
        {image && (isBgMode ? (
            <div class="bg-image">
                <ImageModule src={image} alt={title} class="w-full h-full" priority={priority} />
            </div>
        ) : (
            <a href={pageUrl} class="cover card-cover overflow-hidden hover-scale block">
                <ImageModule src={image} alt={title} class="w-full h-full object-cover" priority={priority} />
            </a>
        ))}
        <div class="content p-6">
            {showTitleInContent && (
                <h3 class="card-title"><a href={pageUrl}>{title}</a></h3>
            )}
            <p class="description text-[var(--text-color-70)] leading-relaxed">
                {
                    fallback && (
                    <span class="self-center px-1 mr-2 text-sm text-[var(--text-color-70)] font-mono uppercase bg-[var(--button-hover-color)] rounded border border-[var(--button-border-color)]">{i18n!.defaultLocale}</span>
                    )
                }
                {description}
            </p>
            <div class="flex items-center justify-start text-sm text-[var(--text-color-70)] mt-4 space-x-4">
                <p class="pubdate flex items-center whitespace-nowrap">
                    <Icon name="fa6-solid:calendar-days" class="mr-1"></Icon>
                    <span class="py-1 px-1">{formatFullDate(pubDate, currentLang)}</span>
                </p>
            </div>
            <div class="flex flex-wrap items-center justify-start text-sm text-[var(--text-color-70)] mt-2 gap-2">
                <p class="words flex items-center whitespace-nowrap mr-2">
                    <Icon name="fa6-solid:pen-nib" class="mr-1"></Icon>
                    <span class="py-1 px-1">{cnNumber(remarkPluginFrontmatter.words || 0)}{t("pagecard.words")}</span>
                </p>
                <p class="reading-time flex items-center whitespace-nowrap mr-2">
                    <Icon name="fa6-solid:clock" class="mr-1"></Icon>
                    <span class="py-1 px-1">{cnReadingTime(remarkPluginFrontmatter.minutes || 0)}</span>
                </p>
                <p class="flex items-center whitespace-nowrap mr-2">
                    <Icon name="fa6-solid:hashtag" class="mr-1"></Icon>
                    <a href={getRelativeLocaleUrl(currentLang, `/archives/?category=${entry.data.category}`)} class="category-tag">{entry.data.category || t("pagecard.uncategorized")}</a>
                </p>
                {/* 标签：卡片底部几枚浅色小签（最多 3 枚，多的折成 +N），点进归档页按标签筛选 */}
                {(entry.data.tags ?? []).slice(0, 3).map((tag) => (
                    <a href={getRelativeLocaleUrl(currentLang, `/archives/?tag=${encodeURIComponent(tag)}`)} class="card-tag">{tag}</a>
                ))}
                {(entry.data.tags?.length ?? 0) > 3 && (
                    <span class="card-tag-more">+{entry.data.tags.length - 3}</span>
                )}
            </div>
        </div>
    </div>
    {/* 整卡点击热区：一张铺满卡面的透明覆盖 <a>，点卡片任何位置都进文章。
        标题、分类这些卡内真链接靠 z-index 浮到覆盖层之上，保持独立可点 */}
    <a href={pageUrl} class="card-overlay" aria-hidden="true" tabindex="-1"></a>
</div>
</div>

<style is:global>
/* ===== 纸页卡片 =====
   外层 wrap 只负责投影与悬停抬升（drop-shadow 会跟随 clip-path 的折角轮廓，
   而 box-shadow 会被 clip-path 整个裁掉，所以投影必须放外层）；
   内层 xuan-paper 负责纸面、直角与右下折角。 */
.post-card-wrap {
  display: block;
  width: 100%;
  max-width: var(--page-width);
  margin: 1.5rem auto;
  filter: drop-shadow(0 1px 2px rgba(70, 60, 45, 0.1)) drop-shadow(0 12px 22px rgba(70, 60, 45, 0.13));
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), filter 0.35s ease;
}

.post-card-wrap:hover {
  transform: translateY(-3px);
  filter: drop-shadow(0 2px 3px rgba(70, 60, 45, 0.12)) drop-shadow(0 18px 30px rgba(70, 60, 45, 0.18));
}

.xuan-paper {
  border-radius: 2px;
  background: var(--paper-sheet);
  /* 右下角切掉一个 14px 的直角三角：真·透明，露出底下的桌面 */
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
}

/* 折角：切口的内侧贴一片带渐变的「翻起来的纸」 */
.xuan-paper::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 15px;
  height: 15px;
  background: linear-gradient(
    315deg,
    color-mix(in srgb, var(--paper-edge) 82%, var(--paper-deep)) 0%,
    var(--paper-deep) 42%,
    var(--paper-sheet) 82%
  );
}

@media (prefers-reduced-motion: reduce) {
  .post-card-wrap,
  .post-card-wrap:hover {
    transition: none;
    transform: none;
  }
}

/* ===== 整卡点击热区 =====
   入口不再只是标题/题签那一小块：一张透明的 <a> 拉通整张卡面。
   它被外层的 clip-path 一起裁掉右下折角，切角处点不进，不会误触。
   卡内的标题、分类链接提升到覆盖层之上（z-index 4 > 3），分类仍跳归档。 */
.card-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.post-card .content a,
.post-card a.cover {
  position: relative;
  z-index: 4;
}

/* ===== 题签：卡片左侧的竖排书签（有封面也插同一枚） ===== */
.tientie {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 56px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18px 0 14px;
  border-right: 1px dashed var(--paper-edge);
  background: color-mix(in srgb, var(--paper-deep) 42%, transparent);
  text-decoration: none;
  z-index: 4; /* 浮在整卡点击热区之上，题签仍是可点的真链接 */
}

/* 置顶标记：钉在题签最上头 */
.tientie-pin {
  margin-bottom: 8px;
  opacity: 0.7;
}

/* 有封面的卡：图在上、文在下。高度跟着卡片宽度收放，窄屏不至于把图压成一条 */
.card-cover {
  height: clamp(150px, 20vw, 230px);
}

.tientie-text {
  writing-mode: vertical-rl;
  font-family: var(--serif-head);
  font-size: 1.02rem;
  letter-spacing: 0.28em;
  line-height: 1;
  color: var(--ink-strong);
  max-height: 210px;
  overflow: hidden;
  /* 竖排文字的截断淡出 */
  -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent);
  mask-image: linear-gradient(to bottom, #000 80%, transparent);
}

/* 横排完整标题：型号前缀（CSP-J-2023 T1-）只有在横排里才读得顺 */
.card-title {
  font-family: var(--serif-head);
  font-size: 1.18rem;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: var(--ink-strong);
  margin: 0 0 0.5rem;
}

.card-title a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s ease;
}

.card-title a:hover {
  color: var(--accent);
}

/* 悬停时题签脚上盖一枚小「宣」印 */
.tientie-seal {
  margin-top: auto;
  width: 17px;
  height: 17px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: var(--paper-sheet);
  font-family: var(--serif-head);
  font-size: 10px;
  line-height: 1;
  border-radius: 2px;
  opacity: 0;
  transform: rotate(-14deg) scale(1.5);
  transition: opacity 0.25s ease, transform 0.32s cubic-bezier(0.2, 1.4, 0.4, 1);
}

.post-card:hover .tientie-seal,
.tientie:focus-visible .tientie-seal {
  opacity: 1;
  transform: rotate(-4deg) scale(1);
}

@media (prefers-reduced-motion: reduce) {
  .tientie-seal {
    transition: none;
    transform: none;
  }
}

/* 题签卡的内容区让出签子的宽度 */
.tientie-content {
  padding-left: 72px;
}

@media (max-width: 640px) {
  .tientie-content {
    padding-left: 60px;
    padding-right: 14px;
  }
  .tientie {
    width: 46px;
  }
}

.hover-scale {
  transition: transform 0.3s ease;
}

.hover-scale:hover {
  transform: scale(1.05);
}
.category-tag {
  transition: all 0.3s ease;
  background-color: transparent;
  display: inline-block;
  border-radius: 0.25rem;
  padding: 0.25rem 0.25rem; 
}

.category-tag:hover {
  color: var(--link-color);
  background-color: var(--button-hover-color);
  text-shadow: 0.5px 0 0 currentColor, -0.5px 0 0 currentColor;
}

/* 标签小签：比分类更轻的一层，浅纸底 + 细边，点进归档页按标签筛选 */
.card-tag {
  font-family: var(--serif);
  font-size: 0.74rem;
  line-height: 1.75;
  padding: 0 0.5em;
  border-radius: 2px;
  border: 1px solid color-mix(in srgb, var(--paper-edge) 88%, transparent);
  background: color-mix(in srgb, var(--paper-deep) 45%, transparent);
  color: var(--ink-mute);
  text-decoration: none;
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.card-tag:hover {
  color: var(--accent);
  background: var(--accent-soft);
  border-color: color-mix(in srgb, var(--accent) 40%, var(--paper-edge));
}

.card-tag-more {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--ink-mute);
}

/* ===== 背景图模式：图片作为卡片背景，从右向左非线性渐隐 ===== */
.postcard-bg-mode {
  position: relative;
}

.postcard-bg-mode .bg-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
}

.postcard-bg-mode .bg-image .image-wrapper {
  width: 100%;
  height: 100%;
  opacity: 0.7; /* 图片整体保持一定透明度，避免与文字抢视觉 */
  transition: transform 0.4s ease;
  /* 桌面端：从右向左渐隐，约一半位置图片完全消失，多段渐变近似平滑（非线性）曲线 */
  -webkit-mask-image: linear-gradient(to left, #000 0%, #000 35%, rgba(0,0,0,0.85) 44%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.15) 55%, transparent 60%, transparent 100%);
          mask-image: linear-gradient(to left, #000 0%, #000 35%, rgba(0,0,0,0.85) 44%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.15) 55%, transparent 60%, transparent 100%);
}

.postcard-bg-mode:hover .bg-image .image-wrapper {
  transform: scale(1.03);
}

.postcard-bg-mode .content {
  position: relative;
  z-index: 1;
}

/* 移动端：图片从上到下渐变、约一半位置消失，顶部留白展示图片，卡片整体加高 */
@media (max-width: 640px) {
  .postcard-bg-mode.has-image .bg-image .image-wrapper {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, rgba(0,0,0,0.85) 40%, rgba(0,0,0,0.5) 48%, rgba(0,0,0,0.15) 55%, transparent 60%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 30%, rgba(0,0,0,0.85) 40%, rgba(0,0,0,0.5) 48%, rgba(0,0,0,0.15) 55%, transparent 60%, transparent 100%);
  }

  /* 顶部留白区域展示图片，文字从下方开始，卡片更高 */
  .postcard-bg-mode.has-image .content {
    padding-top: 6rem;
  }
}
</style>
