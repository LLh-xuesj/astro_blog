---
import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'

interface Props {
    prev: any;
    next: any;
}

const { prev, next } = Astro.props;

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

// 辅助函数：根据文章 id 和当前语言生成正确的 URL
function getPostUrl(id: string) {
  const isDefault = currentLang === i18n?.defaultLocale;
  return isDefault ? `/blog/${id}` : `/${currentLang}/blog/${id}`;
}
---

<nav data-aos="fade-up" class="mt-8 pt-4 blognavi">
    <div class="flex flex-row items-stretch gap-2 sm:gap-4">
        <div class="flex-1 min-w-0">
            {prev && (
            <a
                href={getPostUrl(prev.id)}
                class="group flex h-full flex-col gap-1 rounded-[2px] p-3 no-underline transition-colors hover:bg-[var(--paper-deep)] active:bg-[var(--paper-deep)] sm:p-4"
            >
                <div class="flex items-center gap-1.5 text-[var(--text-color-70)]">
                    <span class="blognavi-dot" aria-hidden="true"></span>
                    <span class="text-sm transition-colors group-hover:text-[var(--text-color)]">{t("blogNavi.prev")}</span>
                </div>
                <span class="blognavi-title transition-colors text-lg text-[var(--text-color)] group-hover:text-[var(--accent)] group-active:text-[var(--accent)]">
                    {prev.data.title}
                </span>
            </a>
            )}
        </div>
        <div class="flex-1 min-w-0">
            {next && (
            <a
                href={getPostUrl(next.id)}
                class="group flex h-full flex-col items-end gap-1 rounded-[2px] p-3 text-right no-underline transition-colors hover:bg-[var(--paper-deep)] active:bg-[var(--paper-deep)] sm:p-4"
            >
                <div class="flex items-center gap-1.5 text-[var(--text-color-70)]">
                    <span class="text-sm transition-colors group-hover:text-[var(--text-color)]">{t("blogNavi.next")}</span>
                    <span class="blognavi-dot" aria-hidden="true"></span>
                </div>
                <span class="blognavi-title transition-colors text-lg text-[var(--text-color)] group-hover:text-[var(--accent)] group-active:text-[var(--accent)]">
                    {next.data.title}
                </span>
            </a>
            )}
        </div>
    </div>
</nav>

<style>
    /* 卷前/卷后：顶上的分隔线改成纸边虚线，标题走老宋体，
       引导点用归档页同款朱砂菱印，hover 时纸色加深而不是浮起一块圆角 */
    .blognavi {
        border-top: 1px dashed var(--paper-edge);
    }
    .blognavi-title {
        font-family: var(--serif-head);
        font-weight: 400;
        letter-spacing: 0.04em;
    }
    .blognavi-dot {
        width: 6px;
        height: 6px;
        background: var(--accent);
        border-radius: 1px;
        transform: rotate(45deg);
        opacity: 0.55;
        transition: opacity 0.2s ease;
    }
    .group:hover .blognavi-dot {
        opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
        .blognavi-dot {
            transition: none;
        }
    }
</style>