---
import '@styles/global.css'
import { siteConfig, licenseConfig, profileConfig } from '@/config'
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Markdown from '@components/misc/Markdown.astro'
import ImageModule from '@components/misc/ImageModule.astro'
import FabMenu from '@components/control/FabMenu.astro'
import SignOff from '@components/SignOff.astro'
import Seal from '@components/Seal.astro'
import RelatedPosts from '@components/RelatedPosts.astro'
import TOC from '@components/TOC.svelte'
import LicenseCard from '@components/misc/LicenseCard.astro'
import Comments from '@components/comment/Comments.svelte'
import Twikoo from '@components/comment/thirdparty/twikoo.astro'
import BlogNavi from '@components/control/BlogNavi.astro'

import { getCollection, render } from 'astro:content'
import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import { Icon } from "astro-icon/components";

import { blogCoverUrl } from '@utils/urlUtils'
import { formatFullDate } from '@/utils/time'
import { cnReadingTime, cnYearMonth } from '@utils/cnText'
import { getBlogEntrySort } from '@utils/contentUtils'
import { getRelativeLocaleUrl } from '@utils/urlUtils';
import { absoluteUrl, articleJsonLd, coverShareImage, normalizePath } from '@utils/seo';


const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

export async function getStaticPaths() {
    
    // 获取所有支持的语言
    const locales = i18n?.locales || [i18n?.defaultLocale];
    
    // 为每种语言和每篇文章组合生成路由
    const paths = [];
    
    for (const locale of locales) {
        const blogEntries = await getBlogEntrySort(locale);

        for (let i = 0; i < blogEntries.length; i++) {
            const entry = blogEntries[i];
            const next = i > 0 ? blogEntries[i - 1] : null;
            const prev = i < blogEntries.length - 1 ? blogEntries[i + 1] : null;

            // 卷尾同观：同分类优先，凑不满就退回最近更新的；只留可序列化的几个字段
            const sameCategory = blogEntries.filter(
                (e) => e.id !== entry.id && e.data.category === entry.data.category
            );
            const relatedPool = sameCategory.length > 0 ? sameCategory : blogEntries.filter((e) => e.id !== entry.id);
            const related = relatedPool.slice(0, 3).map((e) => ({
                id: e.id,
                title: e.data.title,
                pubDate: e.data.pubDate,
            }));

            paths.push({
                params: {
                    locale: locale === i18n?.defaultLocale ? undefined : locale,
                    id: entry.id
                },
                props: {
                    entry,
                    prev,
                    next,
                    related
                }
            });
        }
    }
    
    return paths;
}
const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry); // 获取渲染后的正文内容

const pageTitle = entry.data.title + ' - ' + siteConfig.title;
const image = blogCoverUrl(entry.data.image, entry.id);

const { remarkPluginFrontmatter } = await render(entry);

// 版心小字：分类 · 汉字纪年（换算与文末落款共用）
const banxinXinText = `${entry.data.category || '随笔'} · ${cnYearMonth(entry.data.pubDate)}`

// ---- SEO：分享图（构建期转成 jpg）与文章结构化数据 ----
// 分享图：有封面用封面（构建期转 jpg），没有就生成宣纸风分享卡（/og/<id>.png）
const shareImage = entry.data.image
    ? await coverShareImage(entry.data.image, entry.id)
    : absoluteUrl(`/og/${entry.id}.png`);
const pageUrl = absoluteUrl(normalizePath(Astro.url.pathname));
const postJsonLd = articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    image: shareImage,
    lang: currentLang,
    pubDate: entry.data.pubDate,
    category: entry.data.category,
    words: remarkPluginFrontmatter.words,
    minutes: remarkPluginFrontmatter.minutes,
});
---
<MainPageLayout
    title={pageTitle}
    lang={currentLang}
    description={entry.data.description}
    image={shareImage}
    type="article"
    publishedTime={entry.data.pubDate}
    section={entry.data.category}
    keywords={entry.data.category ? [entry.data.category] : []}
    noindex={entry.data.draft}
    structuredData={postJsonLd}
    markdownFont={true}
>
    <div class="mx-auto w-full max-w-[var(--page-width)] py-8 md:mt-0 mt-18">
        <div class="mb-18 text-center">
            <h1 class="font-bold text-3xl mb-2 pt-10 text-[var(--text-color)]">{ entry.data.title }</h1>
            <p class="flex flex-wrap items-center justify-center font-bold text-[var(--text-color-70)] mt-6">
                <Icon name="fa6-solid:calendar-days" class="mr-2"></Icon>
                <span> { formatFullDate(entry.data.pubDate, currentLang) }</span>
            </p>
            <div class="flex justify-center">
                <div class="flex flex-wrap items-center justify-center text-sm text-[var(--text-color-70)] mt-2 gap-2">
                    <p class="flex items-center whitespace-nowrap mr-2">
                        <Icon name="fa6-solid:pen-nib" class="mr-1"></Icon>
                        <span class="py-1 px-1">{t("pagecard.readInfo", { words: remarkPluginFrontmatter.words || 0, minutes: cnReadingTime(remarkPluginFrontmatter.minutes || 0) })}</span>
                    </p>
                    <p class="flex items-center whitespace-nowrap mr-2">
                        <Icon name="fa6-solid:hashtag" class="mr-1"></Icon>
                        <a href={getRelativeLocaleUrl(currentLang, `/archives/?category=${entry.data.category}`)} class="category-tag">{entry.data.category || t("pagecard.uncategorized")}</a>
                    </p>
                    <!-- 复制本文链接：点一下把永久地址抄进剪贴板，笔尖变对勾 -->
                    <button
                        id="copy-link"
                        type="button"
                        title={t("button.copyLink")}
                        data-copied-text={t("pagecard.copied")}
                        class="flex items-center whitespace-nowrap mr-2 transition-colors hover:text-[var(--accent)]"
                    >
                        <Icon name="fa6-solid:link" class="mr-1"></Icon>
                        <span class="py-1 px-1">{t("button.copyLink")}</span>
                    </button>
                </div>
            </div>
        </div>
        {image && (
            <div class="cover overflow-hidden">
                {/* 文章封面通常就是本页的 LCP 元素：优先加载 */}
                <ImageModule src={image} alt={entry.data.title} class="w-full h-full object-cover" priority />
            </div>
        )}
        {entry.data.draft && (
        <div class="my-8 flex items-start gap-3 rounded-lg border border-[var(--danger-border-color)] bg-[var(--danger-bg-color)] p-4 text-sm text-[var(--danger-text-color)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 opacity-80">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            
            <div>
                <p class="leading-relaxed">
                    <span class="font-semibold">{t("draftNote.warning")}</span>
                    {t("draftNote.description")}
                </p>
            </div>
        </div>
        )}
        {entry.isFallback && (
        <div class="my-8 flex items-start gap-3 rounded-lg border border-[var(--warning-border-color)] bg-[var(--warning-bg-color)] p-4 text-sm text-[var(--warning-text-color)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 opacity-80">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
            </svg>
            
            <div>
            <p class="leading-relaxed">
                <span class="font-semibold">{t("langNote.note")}</span> 
                {t("langNote.description")}
            </p>
            </div>
        </div>
        )}
        <Markdown class="mb-8 mt-10 markdown-content xuan-banxin">
            <Fragment slot="ornament">
             <div class="banxin-layer" aria-hidden="true">
                {/* 朱笔界格：四条手绘边，微微起伏，四角出锋交叉——像现打的界格而非印刷线 */}
                <svg class="banxin-edge banxin-edge-top" viewBox="0 0 1000 22" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M-8 14.2 C150 8.2 330 15.6 500 10.2 C660 6.8 840 14.8 1008 8.6" vector-effect="non-scaling-stroke" />
                </svg>
                <svg class="banxin-edge banxin-edge-bottom" viewBox="0 0 1000 22" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M-8 8.6 C180 14.8 360 7.8 540 13.4 C700 16 860 8.2 1008 13.8" vector-effect="non-scaling-stroke" />
                </svg>
                <svg class="banxin-edge banxin-edge-left" viewBox="0 0 22 1000" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M13.6 -8 C9 150 15.4 330 10.6 500 C7.6 660 14.6 840 9.8 1008" vector-effect="non-scaling-stroke" />
                </svg>
                <svg class="banxin-edge banxin-edge-right" viewBox="0 0 22 1000" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M8.6 -8 C14.8 180 7.8 360 13.4 540 C16 700 8.2 860 13.8 1008" vector-effect="non-scaling-stroke" />
                </svg>

                {/* 版心：界线在正中收进一对鱼尾，夹着分类与汉字纪年——雕版书的招牌 */}
                <div class="banxin-xin">
                    <svg class="banxin-yw-l" viewBox="0 0 20 16" aria-hidden="true"><path d="M0.8 1 C5.5 2.4 14.5 2.4 19.2 1 C15.4 5.6 13.4 9.6 12.8 15 L7.2 15 C6.6 9.6 4.6 5.6 0.8 1 Z" /></svg>
                    <span>{banxinXinText}</span>
                    <svg class="banxin-yw-r" viewBox="0 0 20 16" aria-hidden="true"><path d="M0.8 1 C5.5 2.4 14.5 2.4 19.2 1 C15.4 5.6 13.4 9.6 12.8 15 L7.2 15 C6.6 9.6 4.6 5.6 0.8 1 Z" /></svg>
                </div>

                {/* 飞白：写完这一页，笔锋顺势扫出界外的那一道 */}
                <svg class="banxin-sweep" viewBox="0 0 150 90" aria-hidden="true">
                    <path class="banxin-sweep-1" d="M4 78 C34 74 66 62 118 34 C128 29 138 24 146 18 C100 40 60 58 22 72 C15 74.5 9 76.5 4 78 Z" />
                    <path class="banxin-sweep-2" d="M2 84 C30 82 58 76 96 62 C60 74 28 80 4 84 Z" />
                    <path class="banxin-sweep-3" d="M24 88 C52 84 86 76 122 58 C90 74 54 82 26 86 Z" />
                </svg>

                {/* 镇纸一对：把这一页压住 */}
                <span class="banxin-zhenzhi banxin-pw-l" aria-hidden="true"></span>
                <span class="banxin-zhenzhi banxin-pw-r" aria-hidden="true"></span>

                {/* 骑缝章：半枚印骑在右界上 */}
                <span class="banxin-qifeng"><Seal size="1.7rem" rotate={-8} /></span>
             </div>
            </Fragment>
            <Content />
        </Markdown>
        <SignOff name={profileConfig.name} date={entry.data.pubDate} />
        {related && related.length > 0 && <RelatedPosts posts={related} lang={currentLang} />}
        {licenseConfig.enable &&
        <LicenseCard title={entry.data.title} pubDate={entry.data.pubDate}/>
        }
        {
            siteConfig.blogNavi.enable &&
            <BlogNavi prev={prev} next={next}/>
        }
        {
            (siteConfig.comments.enable && siteConfig.comments.platform === "default") &&
            <Comments postSlug={entry.data.slugId} language={currentLang} postTitle={entry.data.title} client:visible/>
        }
        {
            (siteConfig.comments.enable && siteConfig.comments.platform === "twikoo") &&
            <Twikoo postSlug={entry.data.slugId} language={currentLang} envId={siteConfig.comments.backendUrl}/>
        }
    </div>
    <!-- fixed 浮层：留在 swup 容器内，但在淡入淡出元素之外（见 MainPageLayout 的说明）。
         这里不能用 <Fragment slot="overlay">：包一层普通 div 不会影响 fixed 定位。 -->
    <div slot="overlay">
        <!-- 书脊：中文古籍的书名题在书脊上，这里把文章标题竖排立在页面左缘，
             纯装饰（不可选中、不响应鼠标），宽屏才出现 -->
        <div class="xuan-spine" aria-hidden="true">{entry.data.title}</div>
        {
            siteConfig.toc.enable &&
            <TOC headings={headings} language={currentLang} client:load/>
        }
        <FabMenu headings={headings} showComment={siteConfig.comments.enable} showBackBottom={!siteConfig.comments.enable}/>
    </div>
</MainPageLayout>

<script>
    import { registerPageInit } from '@utils/pageInit';

    // 复制本文链接：抄永久地址进剪贴板，按钮文案换成「已复制」1.6s 后还原。
    // 页面脚本换页只跑一次，按钮在 swup 容器内每次重建，统一走 registerPageInit。
    function setupCopyLink() {
        const btn = document.getElementById('copy-link');
        if (!btn || btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';

        const label = btn.querySelector('span');
        const original = label?.textContent ?? '';
        btn.onclick = async () => {
            try {
                await navigator.clipboard.writeText(window.location.origin + window.location.pathname);
                if (label) label.textContent = btn.dataset.copiedText || '✓';
                setTimeout(() => { if (label) label.textContent = original; }, 1600);
            } catch {
                // 剪贴板权限被拒（非安全上下文等）：静默失败，别打扰阅读
            }
        };
    }
    registerPageInit(setupCopyLink);
</script>

<style>
    /* 书脊：位于内容列左侧与 TOC 对称的位置；超长标题向下截断并做两端淡出 */
    .xuan-spine {
        display: none;
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        left: calc(50vw - var(--page-width) / 2 - 4.25rem);
        writing-mode: vertical-rl;
        max-height: min(60vh, 34rem);
        overflow: hidden;
        font-family: var(--serif-head);
        font-size: 1.05rem;
        letter-spacing: 0.32em;
        line-height: 1;
        color: var(--ink-soft);
        opacity: 0.6;
        pointer-events: none;
        user-select: none;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
        mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    }

    @media (min-width: 1280px) {
        .xuan-spine {
            display: block;
        }
    }
</style>