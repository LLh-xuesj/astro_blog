---
import MainPageLayout from '@layouts/MainPageLayout.astro';
import ImageModule from '@components/misc/ImageModule.astro';
import Cover from '@components/Cover.astro';
import { getRelativeLocaleUrl } from '@utils/urlUtils';

import { siteConfig } from '@/config'

import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

console.log("404 page loaded with locale:", currentLang);

const pageTitle = "404 - " + siteConfig.title;
const indexPage = getRelativeLocaleUrl(currentLang, "/");
---
<MainPageLayout title={pageTitle} lang="zh-CN" noindex={true}>
    <div class="mx-auto w-full max-w-[var(--page-width)] px-4 text-center py-10">
        <div class="flex min-h-[65vh] flex-col items-center justify-center">

            <!-- 视觉主体：老宋体 404，右肩斜钤一枚「虚无之境」竖印 -->
            <div class="relative select-none inline-block px-6">
                    <h1 class="xuan-404-num">404</h1>
                    <div class="xuan-404-seal" aria-hidden="true">虚无之境</div>
                </div>

                <!-- 文案 -->
                <h2 class="mt-4 text-lg font-semibold text-[var(--text-color)] sm:text-xl">
                    {t("page404.title")}
                </h2>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--text-color-70)]">
                    {t("page404.subTitle")}
                </p>

                <!-- 操作按钮 -->
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                    <a href={indexPage}
                    class="group inline-flex items-center gap-2 rounded-lg border border-[var(--ink-strong)] bg-[var(--ink-strong)] px-6 py-2.5 text-sm font-medium text-[var(--paper-sheet)] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent)] hover:border-[var(--accent)] hover:shadow-md">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 10.5 12 3l9 7.5"/>
                            <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/>
                        </svg>
                        {t("page404.backToHome")}
                    </a>

                    <a href="javascript:history.back()"
                    class="group inline-flex items-center gap-2 rounded-lg border border-[var(--button-border-color)] px-6 py-2.5 text-sm font-medium text-[var(--text-color)] transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--button-hover-color)]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 12H5"/>
                            <path d="m12 19-7-7 7-7"/>
                        </svg>
                        {t("page404.backToPreview")}
                    </a>
                </div>

            </div>
        </div>
</MainPageLayout>

<style>
    /* 404 的墨字：老宋体正体，不做渐变不做发光——纸墨本分 */
    .xuan-404-num {
        font-family: var(--serif-head);
        font-weight: 400;
        font-size: clamp(6rem, 20vw, 11rem);
        line-height: 1;
        letter-spacing: 0.04em;
        color: var(--ink-strong);
    }

    /* 「虚无之境」竖排印：斜钤在数字右肩，像画上的一方错印 */
    .xuan-404-seal {
        position: absolute;
        right: -1.6rem;
        top: -1rem;
        writing-mode: vertical-rl;
        background: var(--accent);
        color: var(--paper-sheet);
        font-family: var(--serif-head);
        font-size: 1rem;
        letter-spacing: 0.16em;
        line-height: 1;
        padding: 0.6rem 0.32rem;
        border-radius: 6px;
        transform: rotate(7deg);
        box-shadow: 0 4px 14px -6px color-mix(in srgb, var(--accent) 60%, transparent);
    }
</style>